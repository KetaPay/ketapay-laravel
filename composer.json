{
    "name": "ketapay/ketapay-laravel",
    "description": "Laravel integration for the KetaPay PHP library: config, facade, and verified webhooks as Laravel events",
    "type": "library",
    "license": "MIT",
    "keywords": ["ketapay", "escrow", "payments", "nigeria", "laravel", "webhooks"],
    "homepage": "https://github.com/KetaPay/ketapay-laravel",
    "support": {
        "issues": "https://github.com/KetaPay/ketapay-laravel/issues",
        "docs": "https://docs.ketapay.com"
    },
    "require": {
        "php": ">=8.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "ketapay/ketapay-php": "^0.1@beta"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ketapay-php",
            "options": {
                "versions": {
                    "ketapay/ketapay-php": "0.1.0-beta.1"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "KetaPay\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KetaPay\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["KetaPay\\Laravel\\KetaPayServiceProvider"],
            "aliases": {
                "KetaPay": "KetaPay\\Laravel\\Facades\\KetaPay"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "lint": "phpstan analyse --memory-limit=1G --no-progress",
        "test": "phpunit",
        "test:ci": "phpunit --coverage-clover coverage/clover.xml --log-junit reports/unit.xml --testdox-text reports/unit-testdox.txt"
    }
}
